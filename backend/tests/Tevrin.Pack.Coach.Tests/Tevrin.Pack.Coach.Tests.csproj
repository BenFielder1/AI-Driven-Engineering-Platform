<Project Sdk="Microsoft.NET.Sdk">

  <!-- FR-338, FR-339, FR-340: the coaching pack's tests (definition load and validation, the coach.velocity-load-rules
       guard). Pure unit tests: no database, no Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tevrin.Pack.Coach.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- As the other test projects (Directory.Build.props): requirement-ID test names, public xUnit types. -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tevrin.Engine.Domain/Tevrin.Engine.Domain.csproj" />
    <ProjectReference Include="../../src/Tevrin.Engine.Runtime/Tevrin.Engine.Runtime.csproj" />
    <ProjectReference Include="../../src/Tevrin.Pack.Coach/Tevrin.Pack.Coach.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
