<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tevrin.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tevrin.Api/Tevrin.Api.csproj" />
    <ProjectReference Include="../../src/Tevrin.Infrastructure/Tevrin.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-321: the SDLC definition version 1, as runs were pinned to it before the re-pin. -->
    <None Include="Pipelines/Fixtures/*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- FR-331, FR-332: the engine-controlled fixture-linear pipeline, shared with the engine tests (FR-352: and fixture-cv). -->
    <None Include="../Tevrin.Engine.Tests/Fixtures/fixture-linear.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/brief.schema.json;../Tevrin.Engine.Tests/Fixtures/fixture-scheduled.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-webhook.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/payload.schema.json;../Tevrin.Engine.Tests/Fixtures/fixture-cv.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-veto.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-editorial.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-parallel.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-forecast.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-variants.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-factcheck.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-postmortem.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-qa.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-callsim.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-trends.pipeline.yaml;../Tevrin.Engine.Tests/Fixtures/fixture-oncall.pipeline.yaml" Link="Pipelines/Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- M55 (FR-264–FR-268): types moved from Tevrin.{Api,Domain,Infrastructure} to the engine are imported project-wide, so the frozen
         characterisation suite (Characterisation/, FR-261) compiles unchanged. -->
    <Using Include="Tevrin.Engine.Domain.Agents" />
    <Using Include="Tevrin.Engine.Domain.Artifacts" />
    <Using Include="Tevrin.Engine.Domain.Common" />
    <Using Include="Tevrin.Engine.Domain.Entities" />
    <Using Include="Tevrin.Engine.Domain.Gates" />
    <Using Include="Tevrin.Engine.Domain.Jobs" />
    <Using Include="Tevrin.Engine.Domain.Notifications" />
    <Using Include="Tevrin.Engine.Runtime.Jobs" />
    <Using Include="Tevrin.Engine.Runtime.Notifications" />
    <Using Include="Tevrin.Engine.Runtime.Persistence" />
    <Using Include="Tevrin.Engine.Runtime.Security" />
  </ItemGroup>

</Project>
