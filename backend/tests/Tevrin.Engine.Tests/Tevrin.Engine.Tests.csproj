<Project Sdk="Microsoft.NET.Sdk">

  <!-- FR-262, FR-263: engine tests (architecture rules now; fixture definitions from M57). Pure unit tests: no database,
       no Docker. References the engine projects, and the packs (Tevrin.Pack.Sdlc, Tevrin.Pack.Coach) only for their architecture rules
       (D-0.7.0-23); never Tevrin.{Api,Domain,Infrastructure}. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tevrin.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tevrin.Engine.Domain/Tevrin.Engine.Domain.csproj" />
    <ProjectReference Include="../../src/Tevrin.Engine.Runtime/Tevrin.Engine.Runtime.csproj" />
    <ProjectReference Include="../../src/Tevrin.Engine.Api/Tevrin.Engine.Api.csproj" />
    <ProjectReference Include="../../src/Tevrin.Pack.Sdlc/Tevrin.Pack.Sdlc.csproj" />
    <ProjectReference Include="../../src/Tevrin.Pack.Coach/Tevrin.Pack.Coach.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- M57 fixture definitions and schemas (reused by M59 and M61), embedded like a pack's own files. -->
    <EmbeddedResource Include="Fixtures/*.yaml;Fixtures/*.json" LogicalName="Fixtures/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
