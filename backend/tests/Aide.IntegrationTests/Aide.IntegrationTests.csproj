<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aide.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The CI hangdump option names the tests still running when a hang passes its timeout. -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aide.Api/Aide.Api.csproj" />
    <ProjectReference Include="../../src/Aide.Infrastructure/Aide.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reports tests running longer than 60 s in the CI log, so a hang names its test. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only preset fixtures (FR-74, FR-76), embedded like the shipped presets but under their own prefix. -->
    <EmbeddedResource Include="..\Fixtures\Presets\**\*" LogicalName="Aide.Tests.Presets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
