{
  // Test-only preset (FR-74, FR-76): a small Next.js + Supabase-like stack with every rule kind.
  "id": "test-stack",
  "name": "Test stack",
  "version": "0.9.0",
  "description": "A fixture preset for tests.",
  "stack": ["Next.js", "Supabase"],
  "deployTargets": ["vercel"],
  "requiredEnv": [
    { "key": "NEXT_PUBLIC_API_URL", "targets": ["preview", "production"], "sensitive": false, "description": "Public API URL." },
    { "key": "SERVICE_KEY", "targets": ["production"], "sensitive": true, "description": "Server-only key." }
  ],
  "specSections": [
    { "title": "Data Model & RLS Policies", "guidance": "Per table, per role." },
    { "title": "Environment Variables", "guidance": "Name, scope, environments." }
  ],
  "specConventions": "conventions.md",
  "planRules": {
    "scaffoldFirstWhenEmpty": true,
    "order": [
      { "before": ["supabase/migrations/**"], "after": ["app/api/**"], "reason": "migrations before the API that uses them" },
      { "before": ["lib/*/**", "!lib/api/**"], "after": ["app/**", "!app/api/**"], "soft": true }
    ],
    "exclusive": [
      { "agent": "db-engineer", "notWithGlobs": ["app/**", "components/**"], "reason": "a db-engineer step never shares a step with UI files" }
    ],
    "maxFilesPerStep": [{ "glob": "supabase/migrations/**", "max": 1 }]
  },
  "agents": [
    { "key": "project-scaffolder", "name": "Project scaffolder", "description": "Bootstraps the app.", "owns": ["package.json", "tsconfig.json", "app/layout.tsx"], "skills": [], "prompt": "agents/project-scaffolder.md" },
    { "key": "db-engineer", "name": "Database engineer", "description": "Migrations and RLS.", "owns": ["supabase/migrations/**", "supabase/seed.sql"], "skills": ["supabase-migration"], "prompt": "agents/db-engineer.md" },
    { "key": "domain-logic-engineer", "name": "Domain logic engineer", "description": "Pure rules.", "owns": ["lib/*/**", "!lib/api/**"], "skills": [], "prompt": "agents/domain-logic-engineer.md" },
    { "key": "api-engineer", "name": "API engineer", "description": "Route handlers.", "owns": ["app/api/**", "lib/api/**"], "skills": ["nextjs-api-route"], "prompt": "agents/api-engineer.md" },
    { "key": "ui-engineer", "name": "UI engineer", "description": "Pages and components.", "owns": ["app/**", "!app/api/**", "components/**"], "skills": [], "prompt": "agents/ui-engineer.md" }
  ],
  "review": {
    "checklist": [
      { "category": "security", "item": "RLS on every table.", "severity": "critical" },
      { "category": "api_contracts", "item": "Route handlers validate with Zod.", "severity": "major" }
    ],
    "deterministic": ["rls_on_every_table", "no_secret_env_in_client"]
  },
  "protectedPaths": [
    { "glob": "supabase/migrations/**", "existingOnBase": true, "reason": "immutable migrations" },
    "lib/database.types.ts",
    { "glob": ".env*", "except": [".env.example"] }
  ]
}
