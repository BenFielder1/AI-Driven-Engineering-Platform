{
  "openapi": "3.1.1",
  "info": {
    "title": "AIDE Platform API",
    "version": "v1"
  },
  "paths": {
    "/api/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness: the process is up. No dependency checks.",
        "operationId": "GetHealthLive",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness: the database is reachable and all EF Core migrations are applied.",
        "operationId": "GetHealthReady",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckEntry": {
        "required": [
          "name",
          "status",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckEntry"
            }
          }
        }
      },
      "HealthState": {
        "enum": [
          "Healthy",
          "Degraded",
          "Unhealthy"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    }
  ]
}