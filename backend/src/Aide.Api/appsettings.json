{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "ConsoleExporter": false
  },
  "Llm": {
    "DefaultProvider": "anthropic",
    "AllowSystemKeys": false,
    "RequestTimeout": "00:05:00",
    "KeyCheckTimeout": "00:00:15",
    "MaxOutputTokens": 16000,
    "Providers": {
      "Anthropic": {
        "DefaultModel": "claude-opus-5-5",
        "Models": {
          "IdeaRefinement": "claude-sonnet-5-5"
        }
      },
      "OpenAI": {
        "DefaultModel": "gpt-6-astra",
        "Models": {
          "IdeaRefinement": "gpt-6.1-sol"
        }
      },
      "Ollama": {
        "DefaultModel": "qwen2.5-coder"
      },
      "Fake": {
        "DefaultModel": "fake-1"
      }
    },
    "Pricing": {
      "claude-opus-5-5": {
        "InputPerMTok": 4,
        "OutputPerMTok": 20
      },
      "claude-sonnet-5-5": {
        "InputPerMTok": 2,
        "OutputPerMTok": 10
      },
      "claude-haiku-5-5": {
        "InputPerMTok": 0.1,
        "OutputPerMTok": 0.5
      },
      "gpt-6-astra": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "gpt-6.1-sol": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "qwen2.5-coder": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "fake-1": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      }
    }
  },
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "GitBaseUrl": "https://github.com/",
    "ReleaseMergeMethod": "merge"
  },
  "Live": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Enabled": false
  },
  "Jobs": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "Concurrency": 4,
    "LeaseDuration": "00:05:00"
  },
  "App": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Notifications": {
    "AllowPrivateTargets": false,
    "SweepEnabled": true,
    "DeliverySweepInterval": "00:01:00",
    "GateSweepInterval": "01:00:00",
    "RequestTimeout": "00:00:10"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "aide@aide.local",
    "EnableSsl": true
  }
}
