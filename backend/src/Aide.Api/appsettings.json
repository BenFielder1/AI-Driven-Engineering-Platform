{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "ConsoleExporter": false
  },
  "Llm": {
    "DefaultProvider": "anthropic",
    "AllowSystemKeys": false,
    "RequestTimeout": "00:30:00",
    "StreamIdleTimeout": "00:02:00",
    "KeyCheckTimeout": "00:00:15",
    "MaxOutputTokens": 16000,
    "Providers": {
      "Anthropic": {
        "Enabled": true,
        "DefaultModel": "claude-opus-5-5",
        "Models": {
          "IdeaRefinement": "claude-sonnet-5-5"
        },
        "Catalog": [
          { "Id": "claude-opus-5-5", "Name": "Claude Opus 5.5", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": true },
          { "Id": "claude-sonnet-5-5", "Name": "Claude Sonnet 5.5", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false },
          { "Id": "claude-haiku-5-5", "Name": "Claude Haiku 5.5", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false },
          { "Id": "claude-fable-5-1", "Name": "Claude Fable 5.1", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false },
          { "Id": "claude-opus-5", "Name": "Claude Opus 5", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false },
          { "Id": "claude-sonnet-5", "Name": "Claude Sonnet 5", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false },
          { "Id": "claude-haiku-4-5", "Name": "Claude Haiku 4.5", "MaxOutputTokens": 64000, "ContextTokens": 200000, "Recommended": false }
        ]
      },
      "OpenAI": {
        "Enabled": true,
        "DefaultModel": "gpt-6-astra",
        "Models": {
          "IdeaRefinement": "gpt-6.1-sol"
        },
        "Catalog": [
          { "Id": "gpt-6-astra", "Name": "GPT-6 Astra", "MaxOutputTokens": 16000, "ContextTokens": 400000, "Recommended": false },
          { "Id": "gpt-6.1-sol", "Name": "GPT-6.1 Sol", "MaxOutputTokens": 16000, "ContextTokens": 400000, "Recommended": false }
        ]
      },
      "Ollama": {
        "Enabled": true,
        "DefaultModel": "qwen2.5-coder",
        "Catalog": [
          { "Id": "qwen2.5-coder", "Name": "Qwen2.5 Coder", "MaxOutputTokens": 16000, "ContextTokens": 32768, "Recommended": false }
        ]
      },
      "Fake": {
        "Enabled": true,
        "DefaultModel": "fake-1",
        "Catalog": [
          { "Id": "fake-1", "Name": "Fake (offline)", "MaxOutputTokens": 128000, "ContextTokens": 1000000, "Recommended": false }
        ]
      }
    },
    "Pricing": {
      "claude-opus-5-5": {
        "InputPerMTok": 4,
        "OutputPerMTok": 20
      },
      "claude-sonnet-5-5": {
        "InputPerMTok": 2,
        "OutputPerMTok": 10
      },
      "claude-haiku-5-5": {
        "InputPerMTok": 0.1,
        "OutputPerMTok": 0.5
      },
      "gpt-6-astra": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "gpt-6.1-sol": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "qwen2.5-coder": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      "fake-1": {
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      }
    }
  },
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "GitBaseUrl": "https://github.com/",
    "ReleaseMergeMethod": "merge",
    "App": {
      "ClientId": "",
      "Slug": ""
    }
  },
  "Live": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Enabled": false
  },
  "Jobs": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "Concurrency": 4,
    "LeaseDuration": "00:05:00"
  },
  "App": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Notifications": {
    "AllowPrivateTargets": false,
    "SweepEnabled": true,
    "DeliverySweepInterval": "00:01:00",
    "GateSweepInterval": "01:00:00",
    "RequestTimeout": "00:00:10"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "aide@aide.local",
    "EnableSsl": true
  },
  "Deployments": {
    "Provider": "Vercel",
    "AllowFake": false
  },
  "Databases": {
    "Provider": "Platform"
  }
}
