<Project Sdk="Microsoft.NET.Sdk">

  <!-- FR-200: the deprecated `aide` command, kept for 0.6.0 under the old package id (Aide.Cli) so existing installs keep
       working after `dotnet tool update`. It is built from the `tevrin` sources (src/Aide.Cli) and differs only in its
       entry point, which prints the deprecation notice to stderr first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aide</AssemblyName>
    <RootNamespace>Aide.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aide</ToolCommandName>
    <PackageId>Aide.Cli</PackageId>
    <Description>Deprecated alias of the Tevrin command-line client: use the tevrin command (package Tevrin.Cli).</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Aide.Cli/**/*.cs" Exclude="../Aide.Cli/Program.cs;../Aide.Cli/obj/**;../Aide.Cli/bin/**" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- SPEC D-V6-21: the package ships the PolyForm Shield licence from the repo root. -->
  <PropertyGroup>
    <Authors>Ben Fielder</Authors>
    <Copyright>Copyright 2026 Ben Fielder</Copyright>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/BenFielder1/AI-Driven-Engineering-Platform</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../LICENSE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
