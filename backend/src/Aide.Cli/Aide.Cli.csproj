<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `tevrin` .NET global tool (SPEC FR-52, FR-200), package Tevrin.Cli. Talks to the Tevrin API with a personal API
       token. The deprecated `aide` command is src/Aide.Cli.Alias (package Aide.Cli), built from these same sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tevrin</AssemblyName>
    <RootNamespace>Aide.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tevrin</ToolCommandName>
    <PackageId>Tevrin.Cli</PackageId>
    <Description>Command-line client for Tevrin.</Description>
    <!-- InvariantGlobalization is on, so localized System.CommandLine resources are never used. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aide.Cli.Tests" />
  </ItemGroup>

  <!-- SPEC D-V6-21: the package ships the PolyForm Shield licence from the repo root. -->
  <PropertyGroup>
    <Authors>Ben Fielder</Authors>
    <Copyright>Copyright 2026 Ben Fielder</Copyright>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/BenFielder1/AI-Driven-Engineering-Platform</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../LICENSE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
