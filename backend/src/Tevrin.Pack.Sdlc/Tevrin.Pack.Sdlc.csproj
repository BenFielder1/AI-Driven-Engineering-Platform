       class). Depends on the engine domain only (D-0.7.0-23); the engine never depends on it (FR-263). -->
  <PropertyGroup>
    <RootNamespace>Tevrin.Pack.Sdlc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tevrin.Engine.Domain\Tevrin.Engine.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-290: the SDLC pipeline definition, registered by SdlcPack from this resource. -->
    <EmbeddedResource Include="Definitions/*.yaml" LogicalName="Definitions/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
