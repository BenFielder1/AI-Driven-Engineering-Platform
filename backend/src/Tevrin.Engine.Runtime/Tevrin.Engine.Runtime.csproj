<Project Sdk="Microsoft.NET.Sdk">

  <!-- FR-262: the engine runtime (job queue, LLM layer, notification channels, EF Core entity configurations of the
       engine's tables; later the artifact store, gates and run log). May use EF Core, Npgsql and Microsoft.Extensions.*, never
       ASP.NET Core, Tevrin.{Api,Domain,Infrastructure} or Tevrin.Pack.* (FR-263). Migrations stay in Tevrin.Infrastructure (D-0.7.0-12). -->
  <PropertyGroup>
    <RootNamespace>Tevrin.Engine.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tevrin.Engine.Domain\Tevrin.Engine.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-297, M59: engine tests drive the first-token probe and inspect the prompt stats query. -->
    <InternalsVisibleTo Include="Tevrin.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- The job worker is a hosted BackgroundService (FR-264). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- The LLM layer's HTTP providers and model lookups (FR-265): IHttpClientFactory, outside ASP.NET Core. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Pipeline definitions (FR-275, FR-279, FR-290): YAML loading, JSON Schema checks and the readiness check. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Compile assets stay private: the package's root 'Json' namespace would shadow the host's own 'Json' helpers. -->
    <PackageReference Include="JsonSchema.Net" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>

</Project>
