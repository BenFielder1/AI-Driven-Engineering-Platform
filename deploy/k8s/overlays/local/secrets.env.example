# Template for deploy/k8s/overlays/local/secrets.env (git-ignored). Placeholders only, never real values.
# deploy-local.sh copies this file if secrets.env is missing and fills in a random DB password, the matching
# connection string and a random approval-link signing key. Fill in the optional keys yourself as needed.
# Format: KEY=value, one per line, no quotes, no spaces around '='.

# --- Database (SPEC §9) ---
# POSTGRES_PASSWORD is read by PostgreSQL only on first initialisation of the data volume.
POSTGRES_PASSWORD=change-me
ConnectionStrings__Aide=Host=db;Port=5432;Database=aide;Username=aide;Password=change-me

# --- ASP.NET Data Protection (keys live on the aide-data volume at /data/keys) ---
DataProtection__ApplicationName=aide

# --- Default LLM provider keys (optional; blank = provider unavailable) ---
# v2 (FR-79): runs use the project Owner's bound connection. These system keys are used only when no connection is
# bound AND system keys are allowed. Uncomment to allow them (default false).
# Llm__AllowSystemKeys=true
# Timeout for validating a user's LLM key with the provider (FR-78; default 00:00:15).
# Llm__KeyCheckTimeout=00:00:15
Llm__Providers__Anthropic__ApiKey=
Llm__Providers__OpenAI__ApiKey=
# Ollama endpoint (optional; blank = http://host.docker.internal:11434 from inside the cluster).
Llm__Providers__Ollama__BaseUrl=

# --- GitHub OAuth app (optional) ---
# Leave both blank to disable GitHub sign-in (local email/password sign-in still works).
# GitHub OAuth app "Authorization callback URL": http://localhost:8080/api/auth/github/callback
GitHub__OAuth__ClientId=
GitHub__OAuth__ClientSecret=

# --- One-click approval links (FR-48) ---
# HMAC key for the signed /approvals/<token> links in notifications. At least 32 characters; shorter or missing =
# no approval links are created (fail closed). deploy-local.sh replaces 'change-me', a missing or a too-short value
# with a random 64-character key (other keys are never touched). Changing it invalidates links already sent.
Approvals__SigningKey=change-me

# --- SMTP for the email channel (FR-47; optional) ---
# Blank Smtp__Host = email deliveries are skipped with a logged warning; the other channels still send.
Smtp__Host=
Smtp__Username=
Smtp__Password=
# Non-string (and defaulted) options stay commented out: a blank value (KEY=) would bind an empty string and fail
# config binding/validation at startup. Uncomment and set a value to override the default shown.
# Smtp__Port=587
# Smtp__EnableSsl=true
# Smtp__From=aide@aide.local
# Send timeout (TimeSpan, positive, at most 00:01:00).
# Smtp__Timeout=00:00:15

# The browser-facing base URL used in notification links (App__PublicBaseUrl) is not a secret: it is set in
# app-config-local.yaml (http://localhost:8080).
