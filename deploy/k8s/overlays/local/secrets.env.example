# Template for deploy/k8s/overlays/local/secrets.env (git-ignored). Placeholders only, never real values.
# deploy-local.sh copies this file if secrets.env is missing and fills in a random DB password, the matching
# connection string and a random approval-link signing key. Fill in the optional keys yourself as needed.
# Format: KEY=value, one per line, no quotes, no spaces around '='.

# --- Database (SPEC §9) ---
# POSTGRES_PASSWORD is read by PostgreSQL only on first initialisation of the data volume.
POSTGRES_PASSWORD=change-me
ConnectionStrings__Aide=Host=db;Port=5432;Database=aide;Username=aide;Password=change-me

# --- ASP.NET Data Protection (keys live on the aide-data volume at /data/keys) ---
DataProtection__ApplicationName=aide

# --- Default LLM provider keys (optional; blank = provider unavailable) ---
Llm__Anthropic__ApiKey=
Llm__OpenAI__ApiKey=

# --- GitHub OAuth app (optional) ---
# Leave both blank to disable GitHub sign-in (local email/password sign-in still works).
# GitHub OAuth app "Authorization callback URL": http://localhost:8080/api/auth/github/callback
GitHub__OAuth__ClientId=
GitHub__OAuth__ClientSecret=

# --- Approval-link HMAC signing key (generated) ---
Approvals__SigningKey=change-me

# --- SMTP (optional; blank host = email channel disabled) ---
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=aide@aide.local
Smtp__EnableSsl=true
